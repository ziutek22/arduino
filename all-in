// ******** Trzy diody - wersja z zajęć ********

int ledPinR = 13;
int ledPinG = 12;
int ledPinY = 11;
int inByte = 0;

void setup() {
  pinMode(ledPinR, OUTPUT);
  pinMode(ledPinG, OUTPUT);
  pinMode(ledPinY, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  while (Serial.available() > 0) {
    inByte = Serial.read();
    Serial.println((char)inByte);

    if (inByte == '1') {
      digitalWrite(ledPinR, HIGH);
    } else {
      digitalWrite(ledPinR, LOW);
    }

    if (inByte == '2') {
      digitalWrite(ledPinG, HIGH);
    } else {
      digitalWrite(ledPinG, LOW);
    }

    if (inByte == '3') {
      digitalWrite(ledPinY, HIGH);
    } else {
      digitalWrite(ledPinY, LOW);
    }

    delay(1000);

    if (inByte == 'k') {
      digitalWrite(ledPinR, HIGH);
      digitalWrite(ledPinG, HIGH);
      digitalWrite(ledPinY, HIGH);
    } else {
      digitalWrite(ledPinY, LOW);
    }

    delay(1000);
  }

  if (inByte == 's') {
    digitalWrite(ledPinR, LOW);
    digitalWrite(ledPinG, LOW);
    digitalWrite(ledPinY, LOW);
  } else {
    digitalWrite(ledPinY, HIGH);
  }
}


// ******** Trzy diody - według instrukcji ********

int ledPinR = 13;
int ledPinG = 12;
int ledPinY = 11;
int inByte = 0;

void setup() {
  pinMode(ledPinR, OUTPUT);
  pinMode(ledPinG, OUTPUT);
  pinMode(ledPinY, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  if (Serial.available() > 0) {
    inByte = Serial.read();

    if (inByte == '1') digitalWrite(ledPinR, HIGH);
    if (inByte == '2') digitalWrite(ledPinG, HIGH);
    if (inByte == '3') digitalWrite(ledPinY, HIGH);

    if (inByte == 'k') {
      digitalWrite(ledPinR, LOW);
      digitalWrite(ledPinG, LOW);
      digitalWrite(ledPinY, LOW);
    }

    if (inByte == 's') {
      digitalWrite(ledPinR, HIGH);
      digitalWrite(ledPinG, HIGH);
      digitalWrite(ledPinY, HIGH);
    }
  }
}


