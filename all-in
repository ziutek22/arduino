  char key = keypad.getKey();

  if (key >= '0' && key <= '9') {
    if (wpisany.length() < 4) {
      wpisany += key;
    }
  }

  if (key == '#') {
    if (wpisany == kod) {
      digitalWrite(40, LOW);
      digitalWrite(41, HIGH);
    }

    wpisany = "";
  }

  if (key == '*') {
    digitalWrite(40, HIGH);
    digitalWrite(41, LOW);
    wpisany = "";
  }
}


// ******** Kalkulator czterodziałaniowy ********

// A = dodawanie, B = odejmowanie
// C = mnożenie, D = dzielenie
// # = wynik, * = reset

#include <Keypad.h>
#include <LiquidCrystal.h>

LiquidCrystal lcd(8, 9, 4, 5, 6, 7);

char keys[4][4] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};

byte rowPins[4] = {14, 15, 16, 17};
byte colPins[4] = {18, 19, 20, 21};

Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, 4, 4);

long a = 0, b = 0;
char operacja = 0;

void setup() {
  lcd.begin(16, 2);
}

void loop() {
  char key = keypad.getKey();

  if (!key) return;

  if (key >= '0' && key <= '9') {
    if (operacja == 0) a = a * 10 + key - '0';
    else b = b * 10 + key - '0';

    lcd.print(key);
  }

  if (key >= 'A' && key <= 'D' && operacja == 0) {
    operacja = key;

    lcd.print(key == 'A' ? '+' : key == 'B' ? '-' :
              key == 'C' ? '*' : '/');
  }

  if (key == '#' && operacja != 0) {
    lcd.setCursor(0, 1);

    if (operacja == 'A') lcd.print(a + b);
    if (operacja == 'B') lcd.print(a - b);
    if (operacja == 'C') lcd.print(a * b);

    if (operacja == 'D') {
      if (b != 0) lcd.print((float)a / b);
      else lcd.print("Blad");
    }
  }

  if (key == '*') {
    a = b = 0;
    operacja = 0;
    lcd.clear();
  }
}


