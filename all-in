float celsius = 0;
float fahrenheit = 0;

void setup()
{
  Serial.begin(9600);
}

void findTemps()
{
  float voltage = 0;
  float sensor = 0;

  sensor = analogRead(0);
  voltage = (sensor * 5000) / 1024;
  voltage = voltage - 500;
  celsius = voltage / 10;
  fahrenheit = (1.8 * celsius) + 32;
}

void displayTemps()
{
  Serial.print(" Temperatura wynosi ");
  Serial.print(celsius, 0);
  Serial.print(" st. C / ");
  Serial.print(fahrenheit, 0);
  Serial.println(" st. F");
}

void loop()
{
  findTemps();
  displayTemps();
  delay(1000);
}


