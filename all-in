String kod = "";
String wpisany = "";

void setup() {
  Serial.begin(9600);

  pinMode(40, OUTPUT);
  pinMode(41, OUTPUT);

  digitalWrite(40, HIGH);
  digitalWrite(41, LOW);

  while (kod.length() != 4) {
    if (Serial.available()) {
      kod = Serial.readStringUntil('\n');
      kod.trim();

      if (kod.length() != 4) {
        kod = "";
      }
    }
  }
}

