  unsigned long timeNow = millis();

  if (timeNow - lastTime < 50)
    return;

  steps++;
  lastTime = timeNow;
}


// ******** PIR - przerwanie i TimerOne ********

#include <TimerOne.h>

const int pirSensorPin = 2;
const int ledPin = 13;
const unsigned long timeoutDelay = 5000;

volatile bool motionDetected = false;
volatile unsigned long lastMotionTime = 0;

void setup() {
  pinMode(ledPin, OUTPUT);
  pinMode(pirSensorPin, INPUT);

  attachInterrupt(digitalPinToInterrupt(pirSensorPin), pirISR, RISING);

  Timer1.initialize(100000);
  Timer1.attachInterrupt(turnOffLED);
}

void loop() {
  if (motionDetected) {
    noInterrupts();
    motionDetected = false;
    lastMotionTime = millis();
    interrupts();

    digitalWrite(ledPin, HIGH);
  }
}

void pirISR() {
  motionDetected = true;
}

void turnOffLED() {
  if (digitalRead(pirSensorPin) == LOW &&
      millis() - lastMotionTime >= timeoutDelay) {
    digitalWrite(ledPin, LOW);
  }
}
