// ******** Diody na odległość - wersja z zajęć ********

#include <LiquidCrystal.h>

int TX = 14;
int RX = 15;
int CM;
long TIME;

int zielona = 32;
int zolta = 31;
int czerwona = 30;

LiquidCrystal lcd(8, 9, 4, 5, 6, 7);

void setup()
{
  lcd.begin(16, 2);

  pinMode(TX, OUTPUT);
  pinMode(RX, INPUT);

  pinMode(zielona, OUTPUT);
  pinMode(zolta, OUTPUT);
  pinMode(czerwona, OUTPUT);
}

void loop()
{
  pomiar_odleglosci();

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print(TIME);

  lcd.setCursor(0, 1);
  CM = TIME / 58;
  lcd.print(CM);

  digitalWrite(zielona, LOW);
  digitalWrite(zolta, LOW);
  digitalWrite(czerwona, LOW);

  if (TIME > 0)
  {
    if (CM > 50)
    {
      digitalWrite(zielona, HIGH);
    }
    else if (CM >= 25)
    {
      digitalWrite(zolta, HIGH);
    }
    else
    {
      digitalWrite(czerwona, HIGH);
    }
  }

  delay(1000);
}

void pomiar_odleglosci()
{
  digitalWrite(TX, HIGH);
  delayMicroseconds(10);
  digitalWrite(TX, LOW);

  TIME = pulseIn(RX, HIGH);
}


// ******** Czujnik ruchu PIR ********

int led = 30;
int sensor = 42;
int state = LOW;
int val = 0;

void setup() {
  pinMode(led, OUTPUT);
  pinMode(sensor, INPUT);
  Serial.begin(9600);
}

void loop() {
  val = digitalRead(sensor);

  if (val == HIGH) {
    digitalWrite(led, HIGH);
    delay(10);

    if (state == LOW) {
      Serial.println("Motion detected!");
      state = HIGH;
    }
  }
  else {
    digitalWrite(led, LOW);

    if (state == HIGH) {
      Serial.println("Motion stopped!");
      state = LOW;
    }
  }
}


// ******** Pomiar czasu impulsu PIR ********

int sensor = 42;
int led = 30;
unsigned long start = 0;
int stan = LOW;

void setup() {
  pinMode(sensor, INPUT);
  pinMode(led, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  int val = digitalRead(sensor);

  digitalWrite(led, val);

  if (val == HIGH && stan == LOW)
    start = millis();

  if (val == LOW && stan == HIGH) {
    Serial.print("Czas impulsu [ms]: ");
    Serial.println(millis() - start);
  }

  stan = val;
}


