// ******** Zadanie 3 - edycja MIN i MAX ********

#include <LiquidCrystal.h>

LiquidCrystal lcd(8, 9, 4, 5, 6, 7);

int minimum = 0, maksimum = 10;
int pozycja = 0;

void setup() {
  lcd.begin(16, 2);
  Serial.begin(9600);
}

void loop() {
  int przycisk = analogRead(A0);

  if (przycisk >= 50 && przycisk < 195)
    pozycja = 0;

  if (przycisk >= 195 && przycisk < 380)
    pozycja = 1;

  if (przycisk < 50) {
    if (pozycja == 0) maksimum++;
    else minimum++;
  }

  if (przycisk >= 380 && przycisk < 555) {
    if (pozycja == 0) maksimum--;
    else minimum--;
  }

  if (przycisk >= 555 && przycisk < 790) {
    Serial.print("MAX = ");
    Serial.println(maksimum);
    Serial.print("MIN = ");
    Serial.println(minimum);
  }

  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print(pozycja == 0 ? ">MAX=" : " MAX=");
  lcd.print(maksimum);

  lcd.setCursor(0, 1);
  lcd.print(pozycja == 1 ? ">MIN=" : " MIN=");
  lcd.print(minimum);

  delay(250);
}


